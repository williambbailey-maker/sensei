---
import Layout from '../../components/Layout.astro'
import MapIsland from '../../components/MapIsland.astro'
import ProductCard from '../../components/ProductCard.astro'
import CrossLinks from '../../components/CrossLinks.astro'
import {
  SEO, money, categoryLabel, slugify, pointsFor,
  appNeighborhood, dispensaryPath, appDispensary, categoryPath,
} from '../../lib/site'

export function getStaticPaths() {
  return SEO.neighborhoods.map((n: any) => ({ params: { slug: n.slug }, props: { n } }))
}
const { n } = Astro.props
const title = `${n.neighborhood} Dispensaries — ${n.stores} Shops, Menus & Prices | Sensei`
const description = `Compare ${n.stores} licensed cannabis dispensaries in ${n.neighborhood}, ${n.borough}: ${n.in_stock.toLocaleString()} products in stock. Filter ${n.neighborhood} by category and price on Sensei.`
const canonical = new URL(`/neighborhoods/${n.slug}`, Astro.site).href

const cats = Object.entries(n.categories).sort((a: any, b: any) => b[1] - a[1]) as [string, number][]
const knownStores = new Set(SEO.dispensaries.map((d: any) => d.slug))
const mapPoints = pointsFor(n.stores_list)

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `Cannabis dispensaries in ${n.neighborhood}, ${n.borough}`,
    numberOfItems: n.stores_list.length,
    itemListElement: n.stores_list.map((s: any, i: number) => ({
      '@type': 'ListItem', position: i + 1, name: s.name,
      item: new URL(dispensaryPath(s.slug), Astro.site).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Sensei', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Neighborhoods', item: new URL('/neighborhoods', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: n.neighborhood, item: canonical },
    ],
  },
]
---
<Layout title={title} description={description} jsonld={jsonld}>
  <p class="crumb"><a href="/">Sensei</a> › {n.borough} › Neighborhood</p>
  <p class="eyebrow">{n.borough}</p>
  <h1>Weed in {n.neighborhood}</h1>
  <div class="prose-slot">{'{prose}'} — intro: the lay of the land for buying in {n.neighborhood}.</div>

  <div class="stats">
    <div class="stat glass"><span class="n">{n.stores}</span><span class="k label">Shops</span></div>
    <div class="stat glass"><span class="n">{n.in_stock.toLocaleString()}</span><span class="k label">In stock</span></div>
    <div class="stat glass"><span class="n">{cats.length}</span><span class="k label">Categories</span></div>
  </div>

  <section>
    <h2>Filter {n.neighborhood} by category</h2>
    <div class="chips">
      {cats.map(([cat, c]) => (
        <a class="chip" href={cat === 'pre-rolls' ? categoryPath('pre-rolls') : appNeighborhood(n.neighborhood, cat)}>
          {categoryLabel(cat)} <span class="c">{c}</span>
        </a>
      ))}
    </div>
    <div style="margin-top:16px">
      <a class="cta block" href={appNeighborhood(n.neighborhood)}>Shop all {n.neighborhood} on Sensei →</a>
      <p class="cta-sub">One search across every {n.neighborhood} shop — sorted by price and distance.</p>
    </div>
  </section>

  {mapPoints.length > 0 && (
    <section>
      <h2>On the map</h2>
      <MapIsland points={mapPoints} />
    </section>
  )}

  <section>
    <h2>Dispensaries in {n.neighborhood}</h2>
    <div class="stores">
      {n.stores_list.map((s: any) => (
        <a class="storerow glass" href={knownStores.has(s.slug) ? dispensaryPath(s.slug) : appDispensary(s.slug)}>
          <span>
            <span class="sname">{s.name}</span>
            <span class="saddr">{s.address}</span>
          </span>
          <span class="sn"><b>{s.in_stock.toLocaleString()}</b>in stock</span>
        </a>
      ))}
    </div>
  </section>

  <section>
    <h2>Popular right now</h2>
    <div class="products">
      {n.featured.map((p: any) => <ProductCard p={p} compareLabel="Compare" />)}
    </div>
  </section>

  <CrossLinks exclude="neighborhood" />
</Layout>
