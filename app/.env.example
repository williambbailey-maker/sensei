# Vercel env vars (and local .env). The anon key is public/read-only by design.
# The app falls back to the current project's values if these are unset.
VITE_SUPABASE_URL=https://dywrisybvcorpfhbwgtg.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog — analytics. The project API key is public (write-only, ships in the
# bundle). With no key set, analytics is a no-op and the app runs untouched.
# Host: https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU).
VITE_POSTHOG_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
